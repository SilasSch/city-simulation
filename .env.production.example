# Copy this file outside version control or pass it with `--env-file`.
# Use a long, randomly generated value; never commit the real password.
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_USER=city
POSTGRES_DB=city_simulation

# Exact browser-visible origin, without a path or trailing slash.
CLIENT_ORIGIN=https://city.example.com

# Host port for the reverse proxy and fixed session lifetime in hours.
HTTP_PORT=80
SESSION_TTL_HOURS=24

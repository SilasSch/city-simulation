# Copy this file outside version control or pass it with `--env-file`.
# Use a long, randomly generated value; never commit the real password.
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_USER=city
POSTGRES_DB=city_simulation

# DNS name whose A/AAAA record points at this server. Caddy obtains and renews
# its TLS certificate after ports 80 and 443 are reachable from the internet.
DOMAIN=staging.city.example.com

# Exact browser-visible origin, without a path or trailing slash. Keep this in
# sync with DOMAIN; the application intentionally validates it independently.
CLIENT_ORIGIN=https://staging.city.example.com
TRUST_PROXY_HOPS=1

# Fixed session lifetime in hours.
SESSION_TTL_HOURS=24
SIMULATION_SPEED=60

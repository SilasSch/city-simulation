# PostgreSQL-Verbindung (muss zu docker-compose.yml passen)
DATABASE_URL=postgresql://city:city@localhost:5432/city_simulation

# HTTP-Port des NestJS-Servers
SERVER_PORT=3000

# Erlaubter Origin für WebSocket/REST-CORS im Development ohne Proxy
CLIENT_ORIGIN=http://localhost:4200
TRUST_PROXY_HOPS=0

# Lebensdauer einer Session in Stunden (fester Ablauf, kein Sliding)
SESSION_TTL_HOURS=24
SIMULATION_SPEED=60

# Secure-Flag des Session-Cookies: lokal false (HTTP), in Produktion true
SESSION_COOKIE_SECURE=false

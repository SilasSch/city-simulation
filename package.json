    "axios": "^1.6.0",
    "cookie": "^1.1.1",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.186.1",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "prettier": {
    "singleQuote": true
  }
}
